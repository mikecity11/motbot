# Server-only credentials. Set in Vercel; never share keys in chat.
MOT_AI_ENABLED=false
AI_GATEWAY_API_KEY=
GROQ_API_KEY=
# Public Dynamic project identifier from the Dynamic dashboard. Enable email/social
# login and automatic EVM embedded-wallet creation in that dashboard.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
# Server-only Envio token. MOT uses Monad HyperRPC to verify submitted transactions.
ENVIO_API_TOKEN=
MOT_AI_DATABASE_URL=
MOT_AI_SESSION_SECRET=
MOT_AI_MODEL=google/gemini-3.8-flash
MOT_GROQ_MODEL=openai/gpt-oss-20b
# Optional USD pricing per million tokens; omit if unknown.
MOT_AI_INPUT_USD_PER_TOKEN=
MOT_AI_OUTPUT_USD_PER_TOKEN=
